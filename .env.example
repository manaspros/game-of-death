# Copy to .env and fill in, or export these in your shell before running `npm run bench`.
# `npm run bench` / `npm run bench:watch` load this file automatically.

# Required: which model to run, by `key` from src/bench/models.config.json.
# Add or edit entries there to test other models.
BENCH_MODEL=groq-llama-3.3-70b

# Optional: a second model for Player 2 (model vs model). Leave empty to play the
# scripted baseline bot instead. Both players act concurrently. Can be the same
# key as BENCH_MODEL, or a model from a different provider.
BENCH_MODEL_P2=

# Optional: seconds of rest between rounds (default 8). Gives the providers breathing
# room and shows the "next round" screen in the viewer/video. 0 disables.
BENCH_ROUND_PAUSE_SEC=8

# Optional: minimum milliseconds between API calls to one provider, overriding the
# per-provider defaults (OpenRouter 3200, Groq 2200, AI Studio 4200).
BENCH_MIN_CALL_INTERVAL_MS=

# Optional. One of: skirmish | quick | standard | epic. Defaults to "skirmish"
# (compact 48x40 arena, 20-cell battlefield, 160 gens: attacks can actually reach hearts).
BENCH_PRESET=skirmish

# Optional live spectator: BENCH_SPECTATE=1 starts an event feed (port below);
# `npm run bench:watch` sets it for you. Then run `npm run dev` and open
# http://localhost:5173/spectate.html (add ?port=NNNN if you change the port).
BENCH_SPECTATE=
BENCH_SPECTATE_PORT=8787

# Only the key for the provider of the model you chose is required.
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GOOGLE_AI_STUDIO_API_KEY=
